# Copy this file to ".env" and fill in the real values.
# The .env file is in .gitignore so it never gets uploaded to GitHub.

# From https://dev.twitch.tv/console -> Applications -> Manage (your app)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Twitch username of the streamer to find clips for (the part after twitch.tv/)
STREAMER_LOGIN=kaicenat

# How far back to look for clips, in hours
LOOKBACK_HOURS=24

# How many top clips to keep
TOP_N=10

# --- Phase 3: editing ---
# Whisper model size: tiny, base, small, medium (bigger = more accurate but slower)
WHISPER_MODEL=small
# Spoken language (en = English). Leave empty to auto-detect.
WHISPER_LANGUAGE=en
# Never make clips longer than this many seconds (keeps us in short-clip territory)
MAX_CLIP_SECONDS=60
# Layout: auto (pick for you), split (facecam top + gameplay bottom), crop (one slice on the face)
LAYOUT=auto

# --- Phase 4: review ---
# Leave empty to use Google Drive automatically (G:\My Drive\antclipz).
# Only set this if your Drive is somewhere else, e.g.  REVIEW_DIR=H:\My Drive\antclipz
REVIEW_DIR=
